async def broadcast_command(update, context):
    if not is_admin(update.effective_user.id):
        return
    if not context.args:
        await update.message.reply_text("Использование:\n/broadcast текст")
        return
    text = " ".join(context.args)
    success = 0
    failed = 0
    for user_id in list(users.keys()):
        try:
            await context.bot.send_message(user_id, f"📢 <b>Сообщение от администрации</b>\n\n{text}", parse_mode="HTML")
            success += 1
        except:
            failed += 1
    await update.message.reply_text(f"📢 <b>Рассылка завершена.</b>\n\n✅ Отправлено: {success}\n❌ Не отправлено: {failed}", parse_mode="HTML")

