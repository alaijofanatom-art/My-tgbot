async def find_partner(user_id, context, message=None):
    global waiting_user
    if user_id in banned_users:
        if message:
            await message.reply_text("🚫 Вы заблокированы.")
        return
    if user_id in conversations:
        if message:
            await message.reply_text("💬 Вы уже находитесь в диалоге.")
        return
    if waiting_user == user_id:
        if message:
            await message.reply_text("🔎 Вы уже ищете собеседника...")
        return
    if waiting_user is None:
        waiting_user = user_id
        if message:
            await message.reply_text("🔎 Ищем собеседника...\n\nПодожди немного.")
        return
    partner = waiting_user
    if partner == user_id:
        return
    waiting_user = None
    conversations[user_id] = partner
    conversations[partner] = user_id
    name1 = get_user_name(user_id)
    name2 = get_user_name(partner)
    try:
        await context.bot.send_message(partner, f"💬 <b>Собеседник найден!</b>\n\nВы общаетесь с {name1}.\n\n/stop — выйти\n/next — найти другого", parse_mode="HTML")
        await context.bot.send_message(user_id, f"💬 <b>Собеседник найден!</b>\n\nВы общаетесь с {name2}.\n\n/stop — выйти\n/next — найти другого", parse_mode="HTML")
    except Exception as e:
        logger.error("Ошибка соединения: %s", e)

