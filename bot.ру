async def complaint_callback(update, context):
    query = update.callback_query
    await query.answer()
    user_id = query.from_user.id
    partner = conversations.get(user_id)
    if partner is None:
        await query.message.reply_text("❌ Невозможно пожаловаться: собеседник уже отключён.")
        return
    complaints.append({"from": user_id, "against": partner, "reason": "Жалоба пользователя", "time": datetime.now(), "resolved": False})
    await query.message.reply_text("✅ Жалоба отправлена администрации.")

async def handle_message(update, context):
    user = update.effective_user
    user_id = user.id
    if user_id in banned_users:
        await update.message.reply_text("🚫 Вы заблокированы.")
        return
    partner = conversations.get(user_id)
    if partner is None:
        await update.message.reply_text("ℹ️ Вы сейчас не находитесь в диалоге.\n\nНажми «🔎 Найти собеседника».", reply_markup=main_menu_keyboard(user_id))
        return
    if update.message.text:
        text = update.message.text
        if FORBIDDEN_PATTERN.search(text):
            complaints.append({"from": user_id, "against": partner, "reason": "Запрещённое сообщение", "time": datetime.now(), "resolved": False})
            await update.message.reply_text("⚠️ Сообщение не отправлено: оно нарушает правила чата.")
            return
    users.setdefault(user_id, {"joined": datetime.now(), "messages": 0})
    users[user_id]["messages"] += 1
    try:
        await update.message.copy(chat_id=partner)
    except Exception as e:
        logger.error("Ошибка отправки сообщения: %s", e)

