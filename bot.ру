async def ban_command(update, context):
    if not is_admin(update.effective_user.id):
        return
    if not context.args:
        await update.message.reply_text("Использование:\n/ban ID")
        return
    try:
        target_id = int(context.args[0])
    except ValueError:
        await update.message.reply_text("❌ ID должен быть числом.")
        return
    if target_id == OWNER_ID:
        await update.message.reply_text("❌ Нельзя заблокировать владельца.")
        return
    banned_users.add(target_id)
    partner = disconnect_user(target_id)
    if partner:
        try:
            await context.bot.send_message(partner, "❌ Собеседник был отключён.")
        except:
            pass
    try:
        await context.bot.send_message(target_id, "🚫 Вы были заблокированы администрацией.")
    except:
        pass
    await update.message.reply_text(f"✅ Пользователь <code>{target_id}</code> заблокирован.", parse_mode="HTML")

async def unban_command(update, context):
    if not is_admin(update.effective_user.id):
        return
    if not context.args:
        await update.message.reply_text("Использование:\n/unban ID")
        return
    try:
        target_id = int(context.args[0])
    except ValueError:
        await update.message.reply_text("❌ ID должен быть числом.")
        return
    banned_users.discard(target_id)
    await update.message.reply_text(f"✅ Пользователь <code>{target_id}</code> разблокирован.", parse_mode="HTML")

